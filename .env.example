# AI Studio Andrey proxy environment variables
#
# ANDREY_BASE  — the brain (FastAPI). Server-side only, never sent to the browser.
# ANDREY_TOKEN — REQUIRED. The brain gates every /api/* route behind the
#                `X-Andrey-Token` header and answers 401 without it.
#                Its own .env name is ANDREY_API_TOKEN; either name works here.
ANDREY_BASE=https://hi5.bike/Andrey
ANDREY_TOKEN=

